---
import Base from '../layouts/Base.astro';
import SocialLinks from '../components/SocialLinks.astro';
import TabNav from '../components/TabNav.astro';
import { site, facts, avatar } from '../data/site';
import { highlights } from '../data/highlights';
import { activity } from '../data/activity';

// Masonry without JS: deal the cards round-robin into two columns, so card 1
// and card 2 sit side by side, 3 and 4 below them, and so on. Each column is a
// flex stack, so cards hug their own text instead of padding out to match a
// neighbour, and the columns are free to end at different heights.
//
// Reading order is the catch — the DOM is now [1,3,5,2,4,6]. Every card carries
// its true index as a CSS `order`, which does nothing while the columns are
// laid out, but restores the real sequence when the columns collapse to one on
// narrow screens (see `display: contents` in the stylesheet).
const COLUMN_COUNT = 2;
const columns = Array.from({ length: COLUMN_COUNT }, (_, col) =>
  highlights.map((h, i) => ({ ...h, order: i })).filter((_, i) => i % COLUMN_COUNT === col),
);
---

<Base>
  <header class="hero profile">
    <picture class="avatar">
      <source srcset={avatar.webp} type="image/webp" />
      <img src={avatar.jpg} alt={avatar.alt} width="480" height="480" fetchpriority="high" />
    </picture>

    <div class="hero-text">
      <h1>{site.name}</h1>
      <ul class="facts">
        {facts.map((fact) => <li>{fact}</li>)}
      </ul>

      <div class="link-row">
        <SocialLinks />
        <a class="cv-pill" href="/cv" aria-label="Curriculum vitae" title="CV">
          <span class="cv-mark" aria-hidden="true">CV</span>
        </a>
        <a class="cv-pill wide-pill" href="/2048" aria-label="Play 2048" title="2048">
          <span class="cv-mark" aria-hidden="true">2048</span>
        </a>
      </div>
    </div>
  </header>

  <TabNav />

  <section class="panel" id="panel-highlights" role="tabpanel" aria-labelledby="tab-highlights">
    <div class="cards">
      {
        columns.map((column) => (
          <div class="cards-col">
            {column.map((h) => {
              // Unpublished work has no DOI yet, so it renders as a plain card.
              const Tag = h.href ? 'a' : 'div';
              const linkAttrs = h.href ? { href: h.href, target: '_blank', rel: 'noopener' } : {};
              return (
                <Tag class="card" style={`order:${h.order}`} {...linkAttrs}>
                  <div class="card-head">
                    <h3>{h.title}</h3>
                    <span class="meta">{h.meta}</span>
                  </div>
                  <p class="authors">{h.authors}</p>
                  <p>{h.blurb}</p>
                </Tag>
              );
            })}
          </div>
        ))
      }
    </div>
  </section>

  <section class="panel" id="panel-activity" role="tabpanel" aria-labelledby="tab-activity" hidden>
    <ul class="timeline">
      {
        activity.map((item) => (
          <li>
            <span class="date">{item.date}</span>
            <div class="text">
              <strong class="item-title">
                {item.href ? <a href={item.href}>{item.title}</a> : item.title}
              </strong>
              <p>{item.text}</p>
            </div>
          </li>
        ))
      }
    </ul>
  </section>

  <noscript>
    <style>
      .tabs {
        display: none;
      }
      .panel[hidden] {
        display: block !important;
      }
    </style>
  </noscript>

</Base>

<script is:inline>
  (() => {
    const tabs = [...document.querySelectorAll('[role="tab"]')];
    if (!tabs.length) return;

    const show = (key, push) => {
      tabs.forEach((tab) => {
        const on = tab.dataset.tab === key;
        tab.setAttribute('aria-selected', String(on));
        tab.tabIndex = on ? 0 : -1;
        document.getElementById('panel-' + tab.dataset.tab).hidden = !on;
      });
      if (push) history.replaceState(null, '', key === 'highlights' ? location.pathname : '#' + key);
    };

    tabs.forEach((tab, i) => {
      tab.addEventListener('click', () => show(tab.dataset.tab, true));
      // Left/right arrows move between tabs, per the ARIA tabs pattern.
      tab.addEventListener('keydown', (e) => {
        const dir = e.key === 'ArrowRight' ? 1 : e.key === 'ArrowLeft' ? -1 : 0;
        if (!dir) return;
        e.preventDefault();
        const next = tabs[(i + dir + tabs.length) % tabs.length];
        next.focus();
        show(next.dataset.tab, true);
      });
    });

    // Deep links: /#activity opens straight to that tab.
    const hash = location.hash.slice(1);
    if (tabs.some((t) => t.dataset.tab === hash)) show(hash, false);
  })();
</script>
